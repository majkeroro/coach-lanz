@{
    var active = (ViewData["Active"] as string) ?? "";
    string navCls(string id) => active == id ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@(ViewData["Title"] ?? "Booking Suite")</title>
<link rel="stylesheet" href="~/css/suite.css" />
<script>window.SERVER_CONFIG = @Html.Raw(ViewData["ServerConfig"] ?? "null");</script>
<script src="~/js/business-config.js"></script>
<script src="~/js/booking-engine.js"></script>
<script src="~/js/api-client.js"></script>
</head>
<body>
<header class="top"><div class="nav">
  <a class="brand" href="/"><div class="brand-mark" id="brandMark">B</div><div><span id="brandName">Booking Suite</span><small id="brandTag"></small></div></a>
  <button class="mobile-menu-btn" onclick="document.querySelector('.nav-links').classList.toggle('open')">☰</button>
  <nav class="nav-links">
    <a href="/" class='@navCls("home")'>Home</a>
    <a href="/Services" class='@navCls("services")'>Services</a>
    <a href="/Booking" class='@navCls("booking")'>Book Now</a>
    <a href="/Manage" class='@navCls("manage")'>My Bookings</a>
    <a href="/Admin" class='@navCls("admin")'>Admin</a>
  </nav>
</div></header>
@RenderBody()
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
