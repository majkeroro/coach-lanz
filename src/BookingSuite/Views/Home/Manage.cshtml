@{
    ViewData["Title"] = "My Bookings — Booking Suite";
}
<div class="container" style="padding-bottom:40px">
  <div class="page-head"><h1>My bookings</h1><p class="muted">Look up with booking reference (e.g. BK-XXXXX) or mobile number. Reschedule or cancel instantly.</p></div>
  <div class="card">
    <div style="display:flex;gap:8px;flex-wrap:wrap"><input id="q" placeholder="Enter ref or mobile…" style="flex:1;min-width:200px"/><button class="btn" onclick="search()">Find →</button></div>
    <div id="out" style="margin-top:14px"></div>
  </div>
  <div class="card" style="margin-top:14px">
    <b>📅 Need a new slot?</b> <span class="muted">Live availability, no phone tag.</span>
    <div style="margin-top:10px"><a class="btn btn-sm" href="/Booking">Book again →</a></div>
  </div>
</div>
<footer><div class="container">© <span id="yr"></span> <span class="bname"></span></div></footer>
<script>
function paint(){const c=BS.getConfig();document.documentElement.style.setProperty("--accent",c.business.color);brandName.textContent=c.business.name;brandTag.textContent=c.business.tagline;brandMark.textContent=(c.business.name||"B")[0];document.querySelectorAll(".bname").forEach(e=>e.textContent=c.business.name);yr.textContent=new Date().getFullYear();}
function badge(s){return `<span class="badge b-${s}">${s}</span>`;}
async function search(){
  const c=BS.getConfig();const qv=(q.value.trim()||new URLSearchParams(location.search).get("q")||"");
  q.value=qv;
  if(!qv){out.innerHTML='<span class="muted">Enter a reference or mobile number above.</span>';return;}
  out.innerHTML='<span class="muted">Searching…</span>';
  let res=[];
  try{ res=await BS.findBookings(qv); }
  catch(e){ out.innerHTML=`<div class="notice">Couldn't reach the server. ${e.message}</div>`; return; }
  if(!res.length){out.innerHTML=`<div class="notice">No booking found for "<b>${qv}</b>". Check spelling or <a href="/Booking" style="color:var(--accent);font-weight:800">book a new slot →</a></div>`;return;}
  out.innerHTML=res.map(b=>`
    <div class="card" style="margin:10px 0;background:#0f1615">
      <div style="display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap"><b>${b.serviceName}</b>${badge(b.status)}</div>
      <div class="kv">Ref <b style="color:var(--text)">${b.ref}</b> • ${b.date} at ${b.time} • ${b.staffName} • ${b.locationName||""}</div>
      <div class="kv">${b.name} • ${b.phone} • Total ${c.business.currency}${b.total} • ${b.pay}</div>
      ${b.status!=="cancelled"?`<div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:10px">
        <input type="date" id="d-${b.ref}" value="${b.date}" min="${new Date().toISOString().slice(0,10)}" style="max-width:190px"/>
        <select id="t-${b.ref}" style="max-width:150px"><option>Pick date first</option></select>
        <button class="btn btn-sm" onclick="resched('${b.ref}')">Reschedule</button>
        <a class="btn btn-ghost btn-sm" href="/api/bookings/${b.ref}/ics">⬇ .ics</a>
        <button class="btn btn-danger btn-sm" onclick="cancelB('${b.ref}')">Cancel</button>
      </div>`:`<div class="kv" style="margin-top:8px">Cancelled. <a href="/Booking" style="color:var(--accent)">Rebook →</a></div>`}
    </div>`).join("");
  for(const b of res){
    const d=document.getElementById("d-"+b.ref); if(!d) continue;
    const fill=async()=>{
      const sel=document.getElementById("t-"+b.ref);
      sel.innerHTML="<option>Loading…</option>";
      try{
        const slots=await BS.generateSlots(d.value,b.serviceId,b.staffId,b.ref);
        sel.innerHTML=slots.filter(s=>s.available).map(s=>`<option>${s.time}</option>`).join("")||"<option>No slots</option>";
      }catch(e){ sel.innerHTML="<option>Offline</option>"; }
    };
    d.onchange=fill; await fill();
  }
}
async function resched(ref){
  const d=document.getElementById("d-"+ref).value;const t=document.getElementById("t-"+ref).value;
  if(!d||!t||t.includes("No")||t.includes("Loading")||t.includes("Offline")) return alert("Pick a valid date + time.");
  const cur=(await BS.findBookings(ref))[0];
  if(!cur) return alert("Booking not found.");
  try{
    await BS.apiPatch(ref,{date:d,time:t,phone:cur.phone});
    alert("Rescheduled to "+d+" &#64; "+t); search();
  }catch(e){ alert(e.message); }
}
async function cancelB(ref){
  const c=BS.getConfig();
  if(!confirm(`Cancel ${ref}? ${c.policies.cancel}`)) return;
  const cur=(await BS.findBookings(ref))[0];
  if(!cur) return alert("Booking not found.");
  try{ await BS.apiPatch(ref,{status:"cancelled",phone:cur.phone}); search(); }
  catch(e){ alert(e.message); }
}
paint();
const pre=new URLSearchParams(location.search).get("q"); if(pre){q.value=pre;search();}
</script>
